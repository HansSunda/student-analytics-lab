# ==============================================================================
# STUDENT ANALYTICS LAB - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env.local dan isi dengan kredensial Anda
# ==============================================================================

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI API Key (Untuk fitur asistensi AI, edukasi, rekomendasi insight)
GEMINI_API_KEY=your-gemini-api-key

# Application Settings
NEXT_PUBLIC_APP_NAME="Student Analytics Lab"
NEXT_PUBLIC_APP_URL=http://localhost:3000
PYTHON_ANALYSIS_SERVICE_URL=http://localhost:8000

